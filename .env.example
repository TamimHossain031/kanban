# ─── Database ───────────────────────────────────────────────
# Local (docker compose exposes Postgres on 5432)
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# ─── API ────────────────────────────────────────────────────
# 32+ char random secret. Generate: openssl rand -hex 32
JWT_SECRET="dev-secret-change-me-please-32-chars-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-32-chars-min"
JWT_REFRESH_TTL="7d"
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# ─── Web ────────────────────────────────────────────────────
# URL the browser uses to reach the API
NEXT_PUBLIC_API_URL="http://localhost:4000"
